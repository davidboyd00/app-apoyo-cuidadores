# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Solo proyectos legacy con JWT HS256. Los proyectos con llaves asimétricas
# (ES256/RS256, "JWT Signing Keys" en el dashboard) se verifican contra
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json y no necesitan esto.
SUPABASE_JWT_SECRET=
# SOLO para scripts/ (jobs con service role). NO usar en la API.
SUPABASE_SERVICE_ROLE_KEY=

# LLM
LLM_PROVIDER=gemini          # gemini | claude
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MAX_TOKENS=1024
GEMINI_MODEL=gemini-3.6-flash   # cambiar si Google retira el modelo
GEMINI_THINKING_LEVEL=low       # minimal | low | medium | high (vacío = default del modelo)
LLM_TEMPERATURE=0               # 0 = respuestas deterministas

# Ley 21.719 · versión vigente de la política de privacidad
POLICY_VERSION=2026-09-11

# CORS: orígenes permitidos separados por coma (sin espacios). Vacío = "*".
# Ejemplo prod: CORS_ORIGINS=https://caregivers.app,https://staging.caregivers.app
# Dev (web + móvil local): CORS_ORIGINS=http://localhost:5173,http://localhost:8081
CORS_ORIGINS=
