# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_JWT_SECRET=super-secret-jwt-signing-key
# SOLO para scripts/ (jobs con service role). NO usar en la API.
SUPABASE_SERVICE_ROLE_KEY=

# LLM
LLM_PROVIDER=gemini          # gemini | claude
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MAX_TOKENS=512

# Ley 21.719 · versión vigente de la política de privacidad
POLICY_VERSION=2026-09-11

# CORS: orígenes permitidos separados por coma (sin espacios). Vacío = "*".
# Ejemplo prod: CORS_ORIGINS=https://caregivers.app,https://staging.caregivers.app
CORS_ORIGINS=
